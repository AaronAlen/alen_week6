PORT=5000

# MySQL Database Configuration (Sequelize)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=week6_task_manager
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

# MongoDB Configuration (Mongoose)
