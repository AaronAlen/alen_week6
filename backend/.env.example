# JWT Secrets & Expirations
JWT_ACCESS_SECRET=access_token_secret_key_change_in_production_123!
JWT_REFRESH_SECRET=refresh_token_secret_key_change_in_production_456!
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
