PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Sequelize)
# Option A: Local or Separate credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=week6_task_manager
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_SSL=false

# Option B: Cloud MySQL Connection URL (e.g. TiDB Cloud, Aiven, Railway)
# MYSQL_URL=mysql://<user>:<password>@<host>:<port>/<database>

# MongoDB Configuration (Mongoose) - Local or MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.noxf0yh.mongodb.net/<database>
MONGODB_URI=mongodb://localhost:27017/week6_task_manager_logs

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

